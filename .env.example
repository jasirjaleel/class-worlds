# Copy to .env.local and fill in from your Supabase project. Never commit the real values.

# Project Settings > Database > Connection string
DATABASE_URL=            # pooler connection, used by the app
DATABASE_URL_DIRECT=     # session connection, used by npm run db:migrate

# Project Settings > API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=     # server only: never put this in a NEXT_PUBLIC_ variable
